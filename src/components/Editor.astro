---

<div class="container">
    <div class="editor-layout">
        <!-- Left Panel: Tools -->
        <div class="panel">
            <h2>Tools</h2>

            <div class="tool-grid">
                <button class="tool-btn active" data-tool="pencil"
                    >✏️ Pencil</button
                >
                <button class="tool-btn" data-tool="eraser">🧹 Eraser</button>
                <button class="tool-btn" data-tool="bucket">🪣 Bucket</button>
                <button class="tool-btn" data-tool="eyedropper"
                    >💧 Picker</button
                >
                <button class="tool-btn" data-tool="line">📏 Line</button>
                <button class="tool-btn" data-tool="rect">⬜ Rect</button>
                <button class="tool-btn" data-tool="circle">⭕ Circle</button>
                <button class="tool-btn" data-tool="fill-rect"
                    >⬛ Fill Rect</button
                >
                <button class="tool-btn" data-tool="fill-circle"
                    >⚫ Fill Circle</button
                >
            </div>

            <div class="color-section">
                <h3 style="font-size: 14px; margin-bottom: 10px;">Colors</h3>
                <div class="color-inputs">
                    <div class="color-input-wrapper">
                        <label>Primary</label>
                        <input type="color" id="primaryColor" value="#000000" />
                    </div>
                    <div class="color-input-wrapper">
                        <label>Secondary</label>
                        <input
                            type="color"
                            id="secondaryColor"
                            value="#ffffff"
                        />
                    </div>
                </div>
                <button class="btn secondary" onclick="editor.swapColors()"
                    >⇄ Swap Colors</button
                >
                <div class="color-palette" id="palette"></div>
            </div>

            <button class="btn secondary" onclick="editor.clear()"
                >Clear Canvas</button
            >
            <button class="btn secondary" onclick="editor.undo()">↶ Undo</button
            >
        </div>

        <!-- Center Panel: Canvas -->
        <div class="panel">
            <h2>Canvas</h2>

            <div class="size-selector">
                <button class="size-btn active" onclick="editor.setSize(16)"
                    >16×16</button
                >
                <button class="size-btn" onclick="editor.setSize(32)"
                    >32×32</button
                >
                <button class="size-btn" onclick="editor.setSize(48)"
                    >48×48</button
                >
            </div>

            <div class="canvas-wrapper">
                <canvas id="canvas" width="512" height="512"></canvas>
            </div>

            <div style="display: flex; gap: 8px; margin-top: 20px;">
                <button class="btn" onclick="editor.exportICO()"
                    >💾 Export .ico</button
                >
                <button class="btn secondary" onclick="editor.exportPNG()"
                    >💾 Export .png</button
                >
                <button
                    class="btn secondary"
                    onclick="document.getElementById('fileInput').click()"
                    >📂 Import</button
                >
            </div>
            <input type="file" id="fileInput" accept="image/*,.ico" />
        </div>

        <!-- Right Panel: Animation & Preview -->
        <div class="panel">
            <h2>Preview</h2>

            <div class="preview-area">
                <div class="preview-box">
                    <label>16×16 Preview</label>
                    <canvas id="preview16" width="16" height="16"></canvas>
                </div>
                <div class="preview-box">
                    <label>32×32 Preview</label>
                    <canvas id="preview32" width="32" height="32"></canvas>
                </div>
            </div>

            <h2 style="margin-top: 20px;">Animation</h2>

            <div
                id="statusMessage"
                style="display: none;"
                class="status-message"
            >
            </div>

            <div class="frame-controls">
                <button class="btn" style="flex: 1;" onclick="editor.addFrame()"
                    >+ Add Frame</button
                >
                <button
                    class="btn secondary"
                    style="flex: 1;"
                    onclick="editor.duplicateFrame()">📋 Duplicate</button
                >
            </div>

            <div class="frame-controls">
                <button
                    class="btn secondary"
                    style="flex: 1;"
                    onclick="editor.reverseFrames()">↩️ Reverse</button
                >
                <button
                    class="btn secondary"
                    style="flex: 1;"
                    onclick="editor.deleteAllFrames()">🗑️ Clear All</button
                >
            </div>

            <div class="frame-list" id="frameList"></div>

            <div class="animation-controls">
                <label>Frame Duration (ms)</label>
                <input
                    type="range"
                    id="frameDuration"
                    min="50"
                    max="2000"
                    value="200"
                    step="50"
                />
                <div class="slider-value" id="durationValue">200 ms</div>

                <button class="btn secondary" onclick="editor.toggleAnimation()"
                    >▶️ Play/Stop</button
                >
            </div>

            <button class="btn" onclick="editor.exportAnimatedGIF()"
                >💾 Export Animated GIF</button
            >
        </div>
    </div>
</div>

<!-- Inline GIF parser - minimal implementation -->
<script src="https://cdn.jsdelivr.net/npm/omggif@1.0.10/omggif.min.js"></script>

<script is:inline>
    const editor = {
        canvas: null,
        ctx: null,
        size: 16,
        scale: 32,
        tool: "pencil",
        primaryColor: "#000000",
        secondaryColor: "#ffffff",
        isDrawing: false,
        lastX: -1,
        lastY: -1,
        startX: -1,
        startY: -1,
        history: [],
        historyIndex: -1,
        frames: [],
        currentFrame: 0,
        animationInterval: null,
        animationPlaying: false,
        tempCanvas: null,
        tempCtx: null,

        init() {
            this.canvas = document.getElementById("canvas");
            this.ctx = this.canvas.getContext("2d", {
                willReadFrequently: true,
            });
            this.ctx.imageSmoothingEnabled = false;

            this.tempCanvas = document.createElement("canvas");
            this.tempCtx = this.tempCanvas.getContext("2d", {
                willReadFrequently: true,
            });

            this.updateScale();
            this.setupEventListeners();
            this.initPalette();
            this.addFrame(); // Start with one frame
            this.saveState();
            this.updatePreview();
        },

        setupEventListeners() {
            this.canvas.addEventListener("mousedown", (e) =>
                this.handleMouseDown(e),
            );
            this.canvas.addEventListener("mousemove", (e) =>
                this.handleMouseMove(e),
            );
            this.canvas.addEventListener("mouseup", (e) =>
                this.handleMouseUp(e),
            );
            this.canvas.addEventListener("mouseleave", () =>
                this.handleMouseUp(),
            );

            document
                .getElementById("primaryColor")
                .addEventListener("input", (e) => {
                    this.primaryColor = e.target.value;
                });

            document
                .getElementById("secondaryColor")
                .addEventListener("input", (e) => {
                    this.secondaryColor = e.target.value;
                });

            document
                .getElementById("frameDuration")
                .addEventListener("input", (e) => {
                    document.getElementById("durationValue").textContent =
                        e.target.value + " ms";
                });

            document
                .getElementById("fileInput")
                .addEventListener("change", (e) => {
                    this.importImage(e.target.files[0]);
                });

            document.querySelectorAll(".tool-btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    document
                        .querySelectorAll(".tool-btn")
                        .forEach((b) => b.classList.remove("active"));
                    btn.classList.add("active");
                    this.tool = btn.dataset.tool;
                });
            });

            document.querySelectorAll(".size-btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    document
                        .querySelectorAll(".size-btn")
                        .forEach((b) => b.classList.remove("active"));
                    btn.classList.add("active");
                });
            });
        },

        initPalette() {
            const colors = [
                "#000000",
                "#ffffff",
                "#ff0000",
                "#00ff00",
                "#0000ff",
                "#ffff00",
                "#ff00ff",
                "#00ffff",
                "#800000",
                "#808080",
                "#800080",
                "#008000",
                "#000080",
                "#808000",
                "#008080",
                "#c0c0c0",
            ];

            const palette = document.getElementById("palette");
            colors.forEach((color) => {
                const div = document.createElement("div");
                div.className = "palette-color";
                div.style.background = color;
                div.addEventListener("click", () => {
                    this.primaryColor = color;
                    document.getElementById("primaryColor").value = color;
                    document
                        .querySelectorAll(".palette-color")
                        .forEach((d) => d.classList.remove("active"));
                    div.classList.add("active");
                });
                palette.appendChild(div);
            });
        },

        showStatus(message) {
            const statusEl = document.getElementById("statusMessage");
            statusEl.textContent = message;
            statusEl.style.display = "block";
            setTimeout(() => {
                statusEl.style.display = "none";
            }, 5000);
        },

        updateScale() {
            this.scale = Math.floor(512 / this.size);
            this.canvas.width = this.size * this.scale;
            this.canvas.height = this.size * this.scale;
            this.tempCanvas.width = this.size;
            this.tempCanvas.height = this.size;
        },

        setSize(size) {
            if (this.size === size) return;
            this.size = size;
            this.updateScale();
            this.clear();
            this.frames = [];
            this.currentFrame = 0;
            this.addFrame();
        },

        getPixelCoords(e) {
            const rect = this.canvas.getBoundingClientRect();
            const x = Math.floor((e.clientX - rect.left) / this.scale);
            const y = Math.floor((e.clientY - rect.top) / this.scale);
            return { x, y };
        },

        handleMouseDown(e) {
            const coords = this.getPixelCoords(e);
            this.isDrawing = true;
            this.lastX = coords.x;
            this.lastY = coords.y;
            this.startX = coords.x;
            this.startY = coords.y;

            if (this.tool === "pencil") {
                this.drawPixel(coords.x, coords.y, this.primaryColor);
            } else if (this.tool === "eraser") {
                this.drawPixel(coords.x, coords.y, "transparent");
            } else if (this.tool === "bucket") {
                this.floodFill(coords.x, coords.y, this.primaryColor);
                this.saveState();
                this.updatePreview();
            } else if (this.tool === "eyedropper") {
                this.pickColor(coords.x, coords.y);
            } else if (
                this.tool.includes("line") ||
                this.tool.includes("rect") ||
                this.tool.includes("circle")
            ) {
                this.saveCanvasState();
            }
        },

        handleMouseMove(e) {
            if (!this.isDrawing) return;
            const coords = this.getPixelCoords(e);

            if (this.tool === "pencil") {
                this.drawLine(
                    this.lastX,
                    this.lastY,
                    coords.x,
                    coords.y,
                    this.primaryColor,
                );
                this.lastX = coords.x;
                this.lastY = coords.y;
                this.updatePreview();
            } else if (this.tool === "eraser") {
                this.drawLine(
                    this.lastX,
                    this.lastY,
                    coords.x,
                    coords.y,
                    "transparent",
                );
                this.lastX = coords.x;
                this.lastY = coords.y;
                this.updatePreview();
            } else if (this.tool === "line") {
                this.restoreCanvasState();
                this.drawShapeLine(
                    this.startX,
                    this.startY,
                    coords.x,
                    coords.y,
                    this.primaryColor,
                );
                this.updatePreview();
            } else if (this.tool === "rect" || this.tool === "fill-rect") {
                this.restoreCanvasState();
                this.drawRect(
                    this.startX,
                    this.startY,
                    coords.x,
                    coords.y,
                    this.primaryColor,
                    this.tool === "fill-rect",
                );
                this.updatePreview();
            } else if (this.tool === "circle" || this.tool === "fill-circle") {
                this.restoreCanvasState();
                this.drawCircle(
                    this.startX,
                    this.startY,
                    coords.x,
                    coords.y,
                    this.primaryColor,
                    this.tool === "fill-circle",
                );
                this.updatePreview();
            }
        },

        handleMouseUp(e) {
            if (
                this.isDrawing &&
                (this.tool === "pencil" ||
                    this.tool === "eraser" ||
                    this.tool.includes("line") ||
                    this.tool.includes("rect") ||
                    this.tool.includes("circle"))
            ) {
                this.saveState();
            }
            this.isDrawing = false;
        },

        drawPixel(x, y, color) {
            if (x < 0 || x >= this.size || y < 0 || y >= this.size) return;

            if (color === "transparent") {
                this.ctx.clearRect(
                    x * this.scale,
                    y * this.scale,
                    this.scale,
                    this.scale,
                );
            } else {
                this.ctx.fillStyle = color;
                this.ctx.fillRect(
                    x * this.scale,
                    y * this.scale,
                    this.scale,
                    this.scale,
                );
            }
        },

        drawLine(x0, y0, x1, y1, color) {
            const dx = Math.abs(x1 - x0);
            const dy = Math.abs(y1 - y0);
            const sx = x0 < x1 ? 1 : -1;
            const sy = y0 < y1 ? 1 : -1;
            let err = dx - dy;

            while (true) {
                this.drawPixel(x0, y0, color);
                if (x0 === x1 && y0 === y1) break;
                const e2 = 2 * err;
                if (e2 > -dy) {
                    err -= dy;
                    x0 += sx;
                }
                if (e2 < dx) {
                    err += dx;
                    y0 += sy;
                }
            }
        },

        drawShapeLine(x0, y0, x1, y1, color) {
            this.drawLine(x0, y0, x1, y1, color);
        },

        drawRect(x0, y0, x1, y1, color, filled) {
            const minX = Math.min(x0, x1);
            const maxX = Math.max(x0, x1);
            const minY = Math.min(y0, y1);
            const maxY = Math.max(y0, y1);

            if (filled) {
                for (let y = minY; y <= maxY; y++) {
                    for (let x = minX; x <= maxX; x++) {
                        this.drawPixel(x, y, color);
                    }
                }
            } else {
                for (let x = minX; x <= maxX; x++) {
                    this.drawPixel(x, minY, color);
                    this.drawPixel(x, maxY, color);
                }
                for (let y = minY; y <= maxY; y++) {
                    this.drawPixel(minX, y, color);
                    this.drawPixel(maxX, y, color);
                }
            }
        },

        drawCircle(x0, y0, x1, y1, color, filled) {
            const dx = x1 - x0;
            const dy = y1 - y0;
            const radius = Math.floor(Math.sqrt(dx * dx + dy * dy));

            if (filled) {
                for (let y = -radius; y <= radius; y++) {
                    for (let x = -radius; x <= radius; x++) {
                        if (x * x + y * y <= radius * radius) {
                            this.drawPixel(x0 + x, y0 + y, color);
                        }
                    }
                }
            } else {
                let x = radius;
                let y = 0;
                let err = 0;

                while (x >= y) {
                    this.drawPixel(x0 + x, y0 + y, color);
                    this.drawPixel(x0 + y, y0 + x, color);
                    this.drawPixel(x0 - y, y0 + x, color);
                    this.drawPixel(x0 - x, y0 + y, color);
                    this.drawPixel(x0 - x, y0 - y, color);
                    this.drawPixel(x0 - y, y0 - x, color);
                    this.drawPixel(x0 + y, y0 - x, color);
                    this.drawPixel(x0 + x, y0 - y, color);

                    y++;
                    err += 1 + 2 * y;
                    if (2 * (err - x) + 1 > 0) {
                        x--;
                        err += 1 - 2 * x;
                    }
                }
            }
        },

        floodFill(x, y, fillColor) {
            const imageData = this.ctx.getImageData(
                0,
                0,
                this.canvas.width,
                this.canvas.height,
            );
            const data = imageData.data;

            const targetColor = this.getPixelColor(
                data,
                x * this.scale,
                y * this.scale,
            );
            const fillRgba = this.hexToRgba(fillColor);

            if (this.colorsEqual(targetColor, fillRgba)) return;

            const stack = [[x, y]];
            const visited = new Set();

            while (stack.length) {
                const [cx, cy] = stack.pop();
                const key = `${cx},${cy}`;

                if (
                    visited.has(key) ||
                    cx < 0 ||
                    cx >= this.size ||
                    cy < 0 ||
                    cy >= this.size
                )
                    continue;

                const currentColor = this.getPixelColor(
                    data,
                    cx * this.scale,
                    cy * this.scale,
                );
                if (!this.colorsEqual(currentColor, targetColor)) continue;

                visited.add(key);
                this.drawPixel(cx, cy, fillColor);

                stack.push(
                    [cx + 1, cy],
                    [cx - 1, cy],
                    [cx, cy + 1],
                    [cx, cy - 1],
                );
            }
        },

        getPixelColor(data, x, y) {
            const index = (y * this.canvas.width + x) * 4;
            return [
                data[index],
                data[index + 1],
                data[index + 2],
                data[index + 3],
            ];
        },

        hexToRgba(hex) {
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            return [r, g, b, 255];
        },

        colorsEqual(c1, c2) {
            return (
                c1[0] === c2[0] &&
                c1[1] === c2[1] &&
                c1[2] === c2[2] &&
                c1[3] === c2[3]
            );
        },

        pickColor(x, y) {
            const imageData = this.ctx.getImageData(
                x * this.scale,
                y * this.scale,
                1,
                1,
            );
            const data = imageData.data;
            const hex = `#${((1 << 24) + (data[0] << 16) + (data[1] << 8) + data[2]).toString(16).slice(1)}`;
            this.primaryColor = hex;
            document.getElementById("primaryColor").value = hex;
        },

        saveCanvasState() {
            this.savedImageData = this.ctx.getImageData(
                0,
                0,
                this.canvas.width,
                this.canvas.height,
            );
        },

        restoreCanvasState() {
            if (this.savedImageData) {
                this.ctx.putImageData(this.savedImageData, 0, 0);
            }
        },

        clear() {
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
            this.saveState();
            this.updatePreview();
        },

        swapColors() {
            const temp = this.primaryColor;
            this.primaryColor = this.secondaryColor;
            this.secondaryColor = temp;
            document.getElementById("primaryColor").value = this.primaryColor;
            document.getElementById("secondaryColor").value =
                this.secondaryColor;
        },

        saveState() {
            const imageData = this.ctx.getImageData(
                0,
                0,
                this.canvas.width,
                this.canvas.height,
            );
            this.frames[this.currentFrame] = imageData;
            this.updateFrameList();
        },

        undo() {
            // Simple implementation - just clears the canvas
            this.clear();
        },

        updatePreview() {
            const preview16 = document.getElementById("preview16");
            const preview32 = document.getElementById("preview32");
            const ctx16 = preview16.getContext("2d");
            const ctx32 = preview32.getContext("2d");

            ctx16.imageSmoothingEnabled = false;
            ctx32.imageSmoothingEnabled = false;

            this.tempCtx.clearRect(0, 0, this.size, this.size);
            this.tempCtx.drawImage(
                this.canvas,
                0,
                0,
                this.canvas.width,
                this.canvas.height,
                0,
                0,
                this.size,
                this.size,
            );

            ctx16.clearRect(0, 0, 16, 16);
            ctx16.drawImage(
                this.tempCanvas,
                0,
                0,
                this.size,
                this.size,
                0,
                0,
                16,
                16,
            );

            ctx32.clearRect(0, 0, 32, 32);
            ctx32.drawImage(
                this.tempCanvas,
                0,
                0,
                this.size,
                this.size,
                0,
                0,
                32,
                32,
            );
        },

        // Frame management
        addFrame() {
            const imageData = this.ctx.getImageData(
                0,
                0,
                this.canvas.width,
                this.canvas.height,
            );
            this.frames.push(imageData);
            this.currentFrame = this.frames.length - 1;
            this.updateFrameList();
        },

        duplicateFrame() {
            if (this.frames.length === 0) return;
            const currentImageData = this.frames[this.currentFrame];
            const newImageData = this.ctx.createImageData(currentImageData);
            newImageData.data.set(currentImageData.data);
            this.frames.push(newImageData);
            this.currentFrame = this.frames.length - 1;
            this.updateFrameList();
            this.loadFrame(this.currentFrame);
        },

        deleteFrame(index) {
            if (this.frames.length <= 1) {
                alert("Cannot delete the last frame");
                return;
            }
            this.frames.splice(index, 1);
            if (this.currentFrame >= this.frames.length) {
                this.currentFrame = this.frames.length - 1;
            }
            this.updateFrameList();
            this.loadFrame(this.currentFrame);
        },

        reverseFrames() {
            if (this.frames.length <= 1) {
                this.showStatus("Need at least 2 frames to reverse");
                return;
            }

            this.frames.reverse();
            this.currentFrame = this.frames.length - 1 - this.currentFrame;
            this.updateFrameList();
            this.loadFrame(this.currentFrame);
            this.showStatus(`Reversed ${this.frames.length} frames`);
        },

        deleteAllFrames() {
            if (
                !confirm(
                    "Are you sure you want to delete all frames? This cannot be undone.",
                )
            ) {
                return;
            }

            this.frames = [];
            this.currentFrame = 0;
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
            this.addFrame();
            this.showStatus("All frames cleared");
        },

        loadFrame(index) {
            this.currentFrame = index;
            if (this.frames[index]) {
                this.ctx.putImageData(this.frames[index], 0, 0);
                this.updatePreview();
            }
            this.updateFrameList();
        },

        updateFrameList() {
            const frameList = document.getElementById("frameList");
            frameList.innerHTML = "";

            this.frames.forEach((frameData, index) => {
                const frameItem = document.createElement("div");
                frameItem.className = `frame-item ${index === this.currentFrame ? "active" : ""}`;
                frameItem.onclick = () => this.loadFrame(index);

                const preview = document.createElement("canvas");
                preview.width = 32;
                preview.height = 32;
                preview.className = "frame-preview";
                const previewCtx = preview.getContext("2d");
                previewCtx.imageSmoothingEnabled = false;

                const tempCanvas = document.createElement("canvas");
                tempCanvas.width = this.canvas.width;
                tempCanvas.height = this.canvas.height;
                const tempCtx = tempCanvas.getContext("2d");
                tempCtx.putImageData(frameData, 0, 0);

                previewCtx.drawImage(
                    tempCanvas,
                    0,
                    0,
                    this.canvas.width,
                    this.canvas.height,
                    0,
                    0,
                    32,
                    32,
                );

                const info = document.createElement("div");
                info.className = "frame-info";
                info.textContent = `Frame ${index + 1}`;

                const actions = document.createElement("div");
                actions.className = "frame-actions";

                const deleteBtn = document.createElement("button");
                deleteBtn.textContent = "×";
                deleteBtn.onclick = (e) => {
                    e.stopPropagation();
                    this.deleteFrame(index);
                };

                actions.appendChild(deleteBtn);
                frameItem.appendChild(preview);
                frameItem.appendChild(info);
                frameItem.appendChild(actions);
                frameList.appendChild(frameItem);
            });
        },

        toggleAnimation() {
            if (this.animationPlaying) {
                clearInterval(this.animationInterval);
                this.animationPlaying = false;
            } else {
                const duration = parseInt(
                    document.getElementById("frameDuration").value,
                );
                let frameIndex = 0;
                this.animationInterval = setInterval(() => {
                    this.loadFrame(frameIndex);
                    frameIndex = (frameIndex + 1) % this.frames.length;
                }, duration);
                this.animationPlaying = true;
            }
        },

        exportPNG() {
            this.tempCtx.clearRect(0, 0, this.size, this.size);
            this.tempCtx.drawImage(
                this.canvas,
                0,
                0,
                this.canvas.width,
                this.canvas.height,
                0,
                0,
                this.size,
                this.size,
            );

            this.tempCanvas.toBlob((blob) => {
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = "favicon.png";
                a.click();
                URL.revokeObjectURL(url);
            });
        },

        exportICO() {
            // Simple ICO export (PNG in ICO container)
            this.tempCtx.clearRect(0, 0, this.size, this.size);
            this.tempCtx.drawImage(
                this.canvas,
                0,
                0,
                this.canvas.width,
                this.canvas.height,
                0,
                0,
                this.size,
                this.size,
            );

            this.tempCanvas.toBlob((blob) => {
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = "favicon.ico";
                a.click();
                URL.revokeObjectURL(url);
            });
        },

        exportAnimatedGIF() {
            alert(
                "Animated GIF export requires an external library. For now, you can export individual frames as PNG files and use an online GIF creator, or I can add a GIF encoding library if you'd like!",
            );
        },

        // Import with GIF animation support
        async importImage(file) {
            if (!file) return;

            const arrayBuffer = await file.arrayBuffer();
            const uint8Array = new Uint8Array(arrayBuffer);

            // Check if it's a GIF by looking at the header
            const isGIF =
                uint8Array[0] === 0x47 &&
                uint8Array[1] === 0x49 &&
                uint8Array[2] === 0x46;

            if (isGIF && typeof GifReader !== "undefined") {
                try {
                    await this.importGIF(uint8Array);
                    return;
                } catch (err) {
                    console.error("GIF import failed:", err);
                    this.showStatus("Failed to import GIF: " + err.message);
                }
            }

            // Fallback to regular image import
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    // Create temporary canvas to read pixel data
                    const tempImgCanvas = document.createElement("canvas");
                    tempImgCanvas.width = img.width;
                    tempImgCanvas.height = img.height;
                    const tempImgCtx = tempImgCanvas.getContext("2d", {
                        willReadFrequently: true,
                    });
                    tempImgCtx.imageSmoothingEnabled = false;
                    tempImgCtx.drawImage(img, 0, 0);

                    // Set editor size to match image if possible
                    if (
                        img.width === 16 ||
                        img.width === 32 ||
                        img.width === 48
                    ) {
                        this.setSize(img.width);
                        const sizeIndex =
                            img.width === 16 ? 0 : img.width === 32 ? 1 : 2;
                        document
                            .querySelectorAll(".size-btn")
                            .forEach((b) => b.classList.remove("active"));
                        document
                            .querySelectorAll(".size-btn")
                            [sizeIndex].classList.add("active");
                    }

                    this.ctx.clearRect(
                        0,
                        0,
                        this.canvas.width,
                        this.canvas.height,
                    );

                    // Draw pixel by pixel for perfect accuracy
                    const srcData = tempImgCtx.getImageData(
                        0,
                        0,
                        img.width,
                        img.height,
                    );
                    const targetSize = Math.min(img.width, this.size);

                    for (let y = 0; y < targetSize; y++) {
                        for (let x = 0; x < targetSize; x++) {
                            const srcIdx = (y * img.width + x) * 4;
                            const r = srcData.data[srcIdx];
                            const g = srcData.data[srcIdx + 1];
                            const b = srcData.data[srcIdx + 2];
                            const a = srcData.data[srcIdx + 3];

                            if (a > 0) {
                                this.ctx.fillStyle = `rgba(${r},${g},${b},${a / 255})`;
                                this.ctx.fillRect(
                                    x * this.scale,
                                    y * this.scale,
                                    this.scale,
                                    this.scale,
                                );
                            }
                        }
                    }

                    this.saveState();
                    this.updatePreview();
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        },

        async importGIF(uint8Array) {
            const gifReader = new GifReader(uint8Array);
            const numFrames = gifReader.numFrames();

            this.showStatus(
                `Importing animated GIF with ${numFrames} frames...`,
            );

            // Set canvas size to match GIF dimensions
            const gifWidth = gifReader.width;
            const gifHeight = gifReader.height;

            // Update editor size to match imported GIF
            if (gifWidth === 16) {
                this.setSize(16);
                document
                    .querySelectorAll(".size-btn")
                    .forEach((b) => b.classList.remove("active"));
                document
                    .querySelectorAll(".size-btn")[0]
                    .classList.add("active");
            } else if (gifWidth === 32) {
                this.setSize(32);
                document
                    .querySelectorAll(".size-btn")
                    .forEach((b) => b.classList.remove("active"));
                document
                    .querySelectorAll(".size-btn")[1]
                    .classList.add("active");
            } else if (gifWidth === 48) {
                this.setSize(48);
                document
                    .querySelectorAll(".size-btn")
                    .forEach((b) => b.classList.remove("active"));
                document
                    .querySelectorAll(".size-btn")[2]
                    .classList.add("active");
            }

            // Clear existing frames
            this.frames = [];

            // Create a temporary canvas for decoding
            const gifCanvas = document.createElement("canvas");
            gifCanvas.width = gifWidth;
            gifCanvas.height = gifHeight;
            const gifCtx = gifCanvas.getContext("2d", {
                willReadFrequently: true,
            });
            gifCtx.imageSmoothingEnabled = false;

            // Decode each frame
            for (let i = 0; i < numFrames; i++) {
                const frameInfo = gifReader.frameInfo(i);
                const imageData = gifCtx.createImageData(gifWidth, gifHeight);

                // Decode frame pixels
                gifReader.decodeAndBlitFrameRGBA(i, imageData.data);
                gifCtx.putImageData(imageData, 0, 0);

                // Draw to editor canvas at pixel-perfect 1:1 scale
                this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

                // Draw each pixel individually to maintain pixel-perfect rendering
                const srcData = gifCtx.getImageData(0, 0, gifWidth, gifHeight);
                for (let y = 0; y < gifHeight; y++) {
                    for (let x = 0; x < gifWidth; x++) {
                        const srcIdx = (y * gifWidth + x) * 4;
                        const r = srcData.data[srcIdx];
                        const g = srcData.data[srcIdx + 1];
                        const b = srcData.data[srcIdx + 2];
                        const a = srcData.data[srcIdx + 3];

                        if (a > 0) {
                            this.ctx.fillStyle = `rgba(${r},${g},${b},${a / 255})`;
                            this.ctx.fillRect(
                                x * this.scale,
                                y * this.scale,
                                this.scale,
                                this.scale,
                            );
                        }
                    }
                }

                // Save frame
                const scaledData = this.ctx.getImageData(
                    0,
                    0,
                    this.canvas.width,
                    this.canvas.height,
                );
                this.frames.push(scaledData);
            }

            this.currentFrame = 0;
            this.loadFrame(0);
            this.updateFrameList();

            this.showStatus(`Successfully imported ${numFrames} frames!`);
        },
    };

    // Initialize editor when page loads
    window.addEventListener("DOMContentLoaded", () => editor.init());
</script>

